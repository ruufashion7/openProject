global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: openproject-backend-prod
    scheme: https
    metrics_path: /actuator/prometheus
    scrape_interval: 30s
    authorization:
      type: Bearer
      credentials: ${METRICS_SCRAPE_TOKEN}
    static_configs:
      - targets:
          - ${BACKEND_HOST}
        labels:
          env: render
