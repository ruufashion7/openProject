# Copy to prometheus.yml (or merge) when the Spring Boot app runs on the host
# and Prometheus runs in Docker. macOS/Windows: host.docker.internal
# Linux: add to docker-compose extra_hosts: - "host.docker.internal:host-gateway"
# and use host.docker.internal, or use your LAN IP in targets.

global:
  scrape_interval: 15s

scrape_configs:
  - job_name: openproject-backend-host
    metrics_path: /actuator/prometheus
    scrape_interval: 10s
    static_configs:
      - targets:
          - host.docker.internal:8080
